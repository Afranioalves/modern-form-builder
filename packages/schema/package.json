{
  "name": "@modern-form/schema",
  "version": "0.1.0",
  "description": "Zod schemas and TypeScript types for the modern-form / Camunda 8 form JSON schema.",
  "type": "module",
  "license": "MIT",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
